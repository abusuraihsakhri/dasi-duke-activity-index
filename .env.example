# Dasi Duke Activity Index - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Secret key for HMAC-SHA256 audit trail signing
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-secure-random-key-here

# Optional: separate API key for the legacy audit/chat HTTP endpoints.
# If unset, these endpoints are disabled. Generate independently of AUDIT_SECRET_KEY.
AUDIT_API_KEY=

# Only the deterministic mock provider is implemented.
MODEL_PROVIDER=mock
