{
  "openapi": "3.1.0",
  "info": {
    "title": "Dasi Duke Activity Index API",
    "description": "DASI scoring API with optional authenticated legacy audit demonstration.",
    "version": "1.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational summary; not Prometheus exposition format"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match configured AUDIT_API_KEY; routes disabled if no key configured."
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response (no inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match configured AUDIT_API_KEY; routes disabled if no key configured."
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match configured AUDIT_API_KEY; routes disabled if no key configured."
          }
        ]
      }
    },
    "/api/dasi": {
      "post": {
        "summary": "Calculate a complete DASI questionnaire",
        "description": "Requires all twelve binary item responses. No audit logging.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "responses"
                ],
                "properties": {
                  "responses": {
                    "type": "object",
                    "description": "Keys v1 through v12, each 0 or 1",
                    "additionalProperties": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "DASI score and regression-derived VO2/MET estimates"
          },
          "422": {
            "description": "Invalid or incomplete questionnaire"
          }
        }
      }
    }
  }
}
